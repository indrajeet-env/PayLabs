// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  UNKNOWN
}

enum PaymentRail {
  UPI
  IMPS
  NEFT
  RTGS
  SWIFT
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

enum EvidenceType {
  BALANCE
  BENEFICIARY
  NETWORK
  COMPLIANCE
  DUPLICATE
}

enum DecisionAction {
  RETRY
  HOLD
  ESCALATE
  REJECT
  COMPLETE
}

enum AgentType {
  BALANCE
  NETWORK
  COMPLIANCE
  DUPLICATE
  EVIDENCE
  DECISION
  EXECUTION
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AgentRunStatus {
  SUCCESS
  FAILED
  SKIPPED
  TIMEOUT
}

model Customer {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phone       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts    Account[]
}

model Account {
  id                 String        @id @default(cuid())
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  accountNumber      String        @unique
  balance            Decimal       @db.Decimal(18, 2)
  dailyTransferLimit Decimal       @default(500000.00) @db.Decimal(18, 2)
  minimumReserve     Decimal       @default(1000.00) @db.Decimal(18, 2)
  currency           String        @default("INR")
  status             AccountStatus @default(ACTIVE)
  outgoingPayments   Payment[]     @relation("SenderAccount")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([customerId])
}

model Payment {
  id                    String            @id @default(cuid())
  senderAccountId       String
  senderAccount         Account           @relation("SenderAccount", fields: [senderAccountId], references: [id], onDelete: Restrict)
  receiverName          String
  receiverAccountNumber String
  receiverIFSC          String
  receiverBankName      String
  amount                Decimal           @db.Decimal(18, 2)
  rail                  PaymentRail
  status                PaymentStatus
  requiresInvestigation Boolean           @default(false)
  idempotencyKey        String            @unique
  referenceNumber       String            @unique
  providerReference     String?

  // Network Evidence Metrics
  gatewayResponseCode   String?
  bankResponseCode      String?
  ackReceived           Boolean           @default(true)
  networkLatency        Int               @default(150)
  retryCount            Int               @default(0)
  gatewayLogs           String?
  switchLogs            String?

  // Compliance Evidence Metrics
  amlRiskScore          Int               @default(0)
  amlRiskReasons        Json?
  kycStatus             String            @default("VERIFIED")
  sanctionsMatches      Int               @default(0)
  matchedEntity         String?
  matchedList           String?
  riskEngineResponse    Json?

  investigationCase     InvestigationCase?

  initiatedAt           DateTime          @default(now())
  submittedAt           DateTime?
  completedAt           DateTime?

  @@index([senderAccountId])
  @@index([status])
}

model InvestigationCase {
  id                 String     @id @default(cuid())
  paymentId          String     @unique
  payment            Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status             CaseStatus @default(OPEN)
  priority           CasePriority @default(MEDIUM)
  resolutionSummary  String?
  openedAt           DateTime   @default(now())
  closedAt           DateTime?

  evidences          Evidence[]
  decision           Decision?
  auditLogs          AuditLog[]
  agentRuns          AgentRun[]
}

model Evidence {
  id                String            @id @default(cuid())
  caseId            String
  investigationCase InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type              EvidenceType
  payload           Json
  createdAt         DateTime          @default(now())

  @@index([caseId])
}

model Decision {
  id                String            @id @default(cuid())
  caseId            String            @unique
  investigationCase InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action            DecisionAction
  confidence        Float
  reason            Json
  createdAt         DateTime          @default(now())
}

model AuditLog {
  id                String            @id @default(cuid())
  caseId            String
  investigationCase InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  event             String
  metadata          Json?
  createdAt         DateTime          @default(now())

  @@index([caseId])
}

model AgentRun {
  id                String            @id @default(cuid())
  caseId            String
  investigationCase InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  agentName         AgentType
  input             Json
  output            Json
  latency           Int
  status            AgentRunStatus
  startedAt         DateTime
  endedAt           DateTime

  @@index([caseId])
}